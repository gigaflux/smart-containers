# The number of permanent, steady-state SQL connections the API server maintains to Postgres.
# Centralizing this traffic avoids connection bloat since workers no longer connect to the DB directly.
AIRFLOW__API_SERVER__SQL_ALCHEMY_POOL_SIZE=15

# The maximum number of temporary connections allowed to open beyond the pool size during burst periods
# (e.g., when hundreds of tasks fire simultaneously). Prevents exceeding Postgres max_connections.
AIRFLOW__API_SERVER__SQL_ALCHEMY_MAX_OVERFLOW=25

# The timeout in seconds after which an idle connection is recycled.
# Essential for preventing silent drops or network timeouts on long-running worker operations.
AIRFLOW__API_SERVER__SQL_ALCHEMY_POOL_RECYCLE=1800

# The number of worker processes spawned by the FastAPI framework to handle incoming
# HTTP/gRPC requests from Workers, Triggerers, and CLI nodes. Scale this based on CPU cores.
AIRFLOW__API_SERVER__WORKERS=2

# The timeout in seconds for API server worker processes. Prevents long-running Internal API
# transactions (like massive XCom exchanges) from being prematurely terminated.
AIRFLOW__API_SERVER__WEB_SERVER_WORKER_TIMEOUT=120

# Enables the X-Forwarded headers fix. Critical if you run a reverse proxy (e.g., Nginx, Traefik)
# in front of the API server, ensuring correct client IP and protocol detection.
AIRFLOW__API_SERVER__ENABLE_PROXY_FIX=True

#Enables the ProxyFix middleware layer for the new FastAPI application.
AIRFLOW__API__ENABLE_PROXY_FIX="True"

#Defines the exact number of upstream reverse proxies standing between the client and the Airflow 3 application server.
AIRFLOW__API__PROXY_FIX_NUM_PROXIES="1"

#This environment variable configures the Airflow API/Webserver backend (specifically the underlying Uvicorn/Gunicorn/FastAPI application server)
#to trust proxy headers coming from specified IP addresses.
AIRFLOW__API__FORWARDED_ALLOW_IPS="*"

#Declares the absolute, publicly accessible entry-point URL of your Airflow instance
AIRFLOW__API__BASE_URL=https://localhost:8080
