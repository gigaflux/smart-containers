# The number of permanent, steady-state SQL connections the API server maintains to Postgres.
# Centralizing this traffic avoids connection bloat since workers no longer connect to the DB directly.
AIRFLOW__API_SERVER__SQL_ALCHEMY_POOL_SIZE=15

# The maximum number of temporary connections allowed to open beyond the pool size during burst periods
# (e.g., when hundreds of tasks fire simultaneously). Prevents exceeding Postgres max_connections.
AIRFLOW__API_SERVER__SQL_ALCHEMY_MAX_OVERFLOW=25

# The timeout in seconds after which an idle connection is recycled.
# Essential for preventing silent drops or network timeouts on long-running worker operations.
AIRFLOW__API_SERVER__SQL_ALCHEMY_POOL_RECYCLE=1800

