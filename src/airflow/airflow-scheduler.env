# The interval in seconds at which the scheduler checks the DB for heartbeats.
# Reduced to 5s in Airflow 3 because the new event-driven scheduler processes light event loops efficiently.
AIRFLOW__SCHEDULER__SCHEDULER_HEARTBEAT_SEC=5

# Restricts the maximum number of active DAG runs created in a single scheduler loop cycle.
# Acts as an I/O throttle to prevent massive spikes on the database during rapid scheduling events.
AIRFLOW__SCHEDULER__MAX_DAGRUNS_TO_CREATE_PER_LOOP=20

# The maximum number of permanent SQL connections kept open by the DAG Processor / Scheduler.
# Since these components perform heavy metadata operations, a pool size of 5-10 is optimal.
AIRFLOW__DATABASE__SQL_ALCHEMY_POOL_SIZE=5

# The maximum number of temporary connections allowed to burst beyond the pool size
# during intensive DAG parsing cycles or migrations.
AIRFLOW__DATABASE__SQL_ALCHEMY_MAX_OVERFLOW=10
