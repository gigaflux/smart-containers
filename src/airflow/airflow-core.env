# The hard limit for the maximum number of concurrently running task instances across the ENTIRE Airflow instance.
# Aligns processing scale with database tuning parameters like max_wal_size and checkpoint_timeout.
AIRFLOW__CORE__PARALLELISM=32

# The maximum number of task instances allowed to run concurrently within a single DAG.
# Prevents a single heavy or misconfigured DAG from consuming all execution slots (parallelism)
# and starving other workflows in the Airflow cluster.
AIRFLOW__CORE__MAX_ACTIVE_TASKS_PER_DAG=16

# The maximum number of active DAG runs (execution dates) allowed concurrently per DAG.
# Prevents historical backfills or catchup spikes from overwhelming the system if a pipeline fails consecutively.
AIRFLOW__CORE__MAX_ACTIVE_RUNS_PER_DAG=3

# Controls how frequently (in seconds) the system refreshes the serialized DAG structure
# from the database. Increasing this reduces read query pressure on Postgres metadata tables.
AIRFLOW__CORE__MIN_SERIALIZED_DAG_FETCH_INTERVAL=10

# Determines the execution engine for distributing tasks. In Airflow 3, this dictates whether
# tasks are handled locally or routed via an internal API layer (e.g., CeleryExecutor, LocalExecutor).
AIRFLOW__CORE__EXECUTOR=CeleryExecutor

# Whether to load the built-in demonstration and tutorial DAGs.
# Must be set to False to keep production and clean environments free of metadata clutter.
AIRFLOW__CORE__LOAD_EXAMPLES=False

# When set to True, the scheduler relies strictly on localized Python file paths instead of
# pickling DAG objects into the database. Significantly reduces database bloat and I/O overhead.
AIRFLOW__CORE__DONOT_PICKLE=True

# The time (in seconds) allowed for a task to perform graceful cleanup (closing DB connections,
# flushing logs) after receiving a SIGTERM before being forcefully terminated via SIGKILL.
AIRFLOW__CORE__KILLED_TASK_CLEANUP_TIME=60

