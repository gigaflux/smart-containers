# The interval in seconds at which the dedicated DAG Processor rescans the DAG directory.
# Increased to 5s to dramatically reduce continuous read/write metadata transaction stress on Postgres.
AIRFLOW__DAG_PROCESSOR__DAG_DIR_LIST_INTERVAL=5

# The number of parallel OS processes spawned to parse heavy Python code within the DAG files.
# Best practice is to align this with available CPU cores allocated to the container.
AIRFLOW__DAG_PROCESSOR__PARSING_PROCESSES=4

# The maximum number of permanent SQL connections kept open by the DAG Processor / Scheduler.
# Since these components perform heavy metadata operations, a pool size of 5-10 is optimal.
AIRFLOW__DATABASE__SQL_ALCHEMY_POOL_SIZE=5

# The maximum number of temporary connections allowed to burst beyond the pool size
# during intensive DAG parsing cycles or migrations.
AIRFLOW__DATABASE__SQL_ALCHEMY_MAX_OVERFLOW=10
