# The maximum number of concurrent triggers (deferrable tasks) a single triggerer process will handle.
# Defaults to 1000. Can be scaled up to 2000-5000 if your DAGs rely heavily on async sensors/operators.
AIRFLOW__TRIGGERER__CAPACITY=1000

# The number of parallel threads spawned for internal synchronous worker logic within the triggerer.
AIRFLOW__TRIGGERER__SERVER_WORKER_THREADS=4
